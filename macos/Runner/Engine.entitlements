<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Entitlements for the bundled cinematic engine binaries (Node, the
	     Chromium headless shell, the Remotion compositor + its ffmpeg). V8 and
	     Chromium JIT-compile and map executable memory, and they load their own
	     unsigned third-party dylibs — all of which the hardened runtime blocks by
	     default. These relax exactly those checks so the binaries pass
	     notarization yet still run. Applied only to the engine, never the app. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
</dict>
</plist>
